# Copie este archivo como .env y escriba sus propios valores.
# El archivo .env nunca se sube al repositorio.

PUERTO=4000
ORIGEN_FRONTEND=http://localhost:5173

DB_HOST=localhost
DB_PUERTO=3306
DB_USUARIO=root
DB_PASSWORD=
DB_NOMBRE=basuracero

# Secreto para firmar los tokens. Debe ser una cadena larga y propia.
JWT_SECRETO=
JWT_EXPIRACION=8h

# Contrasena que se asigna a los usuarios de prueba al correr npm run semilla.
SEMILLA_PASSWORD=
